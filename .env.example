# ==========================================
# InvoiceGuard AI - Environment Configuration
# ==========================================

# Application
PROJECT_NAME="InvoiceGuard AI"
API_V1_STR="/api"

# Database (SQLite by default; PostgreSQL compatible)
DATABASE_URL="sqlite:///./invoiceguard.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/invoiceguard"

# Security & JWT
SECRET_KEY="invoiceguard-super-secret-jwt-key-2026-production-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Document Storage Vault
STORAGE_DIR="./storage/invoices"
MAX_UPLOAD_SIZE_MB=25

# n8n Automation Engine
N8N_WEBHOOK_URL="http://localhost:5678/webhook/new-invoice"
N8N_WEBHOOK_SECRET="n8n_invoiceguard_secret_2026"

# Optional External AI Engine (Rule-based heuristic fallback active by default)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Statutory Verification
GST_PORTAL_VERIFY_ENABLED=true
