# ==========================================
# InvoiceGuard AI - Root .gitignore
# ==========================================

# ---- Environment & Secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl
.Python
pip-log.txt
pip-delete-this-directory.txt
*.pyo
*.pyd
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/
env/
ENV/

# ---- Database ----
*.db
*.sqlite3
*.sqlite
backend/*.db
backend/*.sqlite3

# ---- Storage / Uploaded Files ----
storage/invoices/*
!storage/invoices/.gitkeep
backend/storage/*
!backend/storage/.gitkeep

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/

# ---- Logs ----
logs/
*.log

# ---- OS Generated ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- IDE / Editor ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---- Misc ----
*.bak
*.tmp
*.temp
*.orig
