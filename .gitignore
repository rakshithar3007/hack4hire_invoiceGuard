# ==============================================================================
# InvoiceGuard AI - Enterprise Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (NEVER commit credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.p12

# ------------------------------------------------------------------------------
# 2. Python Backend & Testing
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.whl
.Python
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
.ruff_cache/
.mypy_cache/

# Virtual Environments
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
*/ENV/
backend/venv/
backend/.venv/

# ------------------------------------------------------------------------------
# 3. Database & Ephemeral Data
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/*.db
backend/*.sqlite3
backend/*.sqlite
backend/invoiceguard.db

# ------------------------------------------------------------------------------
# 4. Storage & Uploaded Invoices (Preserve structure via .gitkeep)
# ------------------------------------------------------------------------------
storage/invoices/*
!storage/invoices/
!storage/invoices/.gitkeep
backend/storage/invoices/*
!backend/storage/
!backend/storage/.gitkeep
!backend/storage/invoices/
!backend/storage/invoices/.gitkeep
uploads/
*/uploads/
tmp/
temp/

# ------------------------------------------------------------------------------
# 5. Node.js & React Frontend
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/

# Frontend Build outputs
frontend/dist/
frontend/dist-ssr/
dist/

# TypeScript / Vite Cache
*.tsbuildinfo
.vite/
frontend/.vite/
*/.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Operating System Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------------------------
# 7. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 8. Temporary & Backup Files
# ------------------------------------------------------------------------------
*.bak
*.tmp
*.temp
*.orig
*.rej
